# ============================================================
# Copy this file to `.env` and fill values as needed.
# `.env` is gitignored. Never commit real secrets.
# Every chapter that needs a variable reads from this file.
# ============================================================

# --- General ---
APP_ENV=local                       # local | dev | prod
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- Auth (Chapter 05) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXP_MINUTES=60
API_KEY=local-dev-api-key

# --- Redis (Chapters 18-21) ---
REDIS_URL=redis://localhost:6379/0

# --- Database (Chapter 22) ---
# Async SQLite by default; swap for Postgres in real deployments.
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/app

# --- OpenAI / LLM (Chapters 24-29) ---
# Leave empty to use the mock client baked into the chapters.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Uploads (Chapter 08, 29) ---
UPLOAD_DIR=./_uploads
MAX_UPLOAD_MB=20
